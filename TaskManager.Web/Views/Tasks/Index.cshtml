@model TaskManager.Web.Models.PagedResultViewModel<TaskManager.Web.Models.TaskViewModel>

@{
    ViewData["Title"] = "Tareas";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <h1>Tareas
        <a asp-action="Create" class="btn btn-sm btn-primary">Agregar</a>
    </h1>

    <p>Mostrando @Model.Items.Count() de @Model.TotalCount</p>

    <!--Se añaden clases a las tablas-->
    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Título</th>
                <th>Categoría</th>
                <th>Completada</th>
                <th>Step</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Items)
            {
                <tr>
                    <td>@t.Id</td>
                    <td>@t.Title</td>
                    <td>@t.CategoryName</td>
                    <td>@(t.IsCompleted ? "Sí" : "No")</td>
                    <td>@t.Step</td>
                    <td> <!--28ene-->
                        <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-primary">Editar</a>
                        <form asp-action="Delete" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@t.Id" />
                            <button type="submit" class="btn btn-danger btn-sm"
                                    onclick="return confirm('¿Estás seguro de que deseas eliminar esta tarea?');">
                                Eliminar
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>