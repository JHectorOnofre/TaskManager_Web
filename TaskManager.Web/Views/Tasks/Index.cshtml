@model TaskManager.Web.Models.TaskSearchViewModel 

@{
    ViewData["Title"] = "Tareas";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">

    <partial name="_AlertMessages" />

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Listado de Tareas</h1>
        <a asp-action="Create" class="btn btn-primary">Agregar Nueva Tarea</a>
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h5 class="card-title">Filtros de Búsqueda</h5>
            <form method="get" asp-action="Index" class="row g-3"> <!--Apuntamos al Método Get / Index principal-->
                <div class="col-md-3">
                    <label class="form-label">Texto</label>
                    <input asp-for="Text" class="form-control" placeholder="Buscar por título..." />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Categoría (Id)</label>
                    <input asp-for="CategoryId" class="form-control" type="number" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Nombre Categoría</label>
                    <input asp-for="CategoryName" class="form-control" placeholder="Ej: Trabajo" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Step</label>
                    <input asp-for="Step" class="form-control" type="number" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Estado</label>
                    <select asp-for="IsCompleted" class="form-select">
                        <option value="">-- Todos --</option>
                        <option value="true">Completadas</option>
                        <option value="false">Pendientes</option>
                    </select>
                </div>

                <div class="col-md-12 text-end">
                    <button type="submit" class="btn btn-success">Aplicar Filtros</button>
                    <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Result != null && Model.Result.Items.Any())
    {
        <p class="text-muted">Mostrando @Model.Result.Items.Count() de @Model.Result.TotalCount tareas encontradas.</p>

        <table class="table table-striped table-bordered table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Título</th>
                    <th>Categoría</th>
                    <th>Estado</th>
                    <th>Step</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Result.Items)
                {
                    <tr>
                        <td>@t.Id</td>
                        <td>@t.Title</td>
                        <td>@t.CategoryName</td>
                        <td>
                            <span class="badge @(t.IsCompleted ? "bg-success" : "bg-warning text-dark")">
                                @(t.IsCompleted ? "Completada" : "Pendiente")
                            </span>
                        </td>
                        <td>@t.Step</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-info text-white">Ver</a>
                            <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-warning">Editar</a>

                            <form asp-action="Delete" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@t.Id" />
                                <button type="submit" class="btn btn-danger btn-sm"
                                        onclick="return confirm('¿Estás seguro de que deseas eliminar esta tarea?');">
                                    Eliminar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Math.Ceiling((double)Model.Result.TotalCount / Model.PageSize); i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-Page="@i"
                           asp-route-Text="@Model.Text"
                           asp-route-CategoryId="@Model.CategoryId"
                           asp-route-CategoryName="@Model.CategoryName"
                           asp-route-Step="@Model.Step"
                           asp-route-IsCompleted="@Model.IsCompleted">
                            @i
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
    else
    {
        <div class="alert alert-info">No se encontraron tareas con los filtros seleccionados.</div>
    }

</div>