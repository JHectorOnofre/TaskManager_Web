@model TaskManager.Web.Models.PagedResultViewModel<TaskManager.Web.Models.TaskViewModel>

@{
    ViewData["Title"] = "Tareas";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">

    @if (TempData["Success"] != null)
    {
        /* Añadimos clase alert */
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <h1>Tareas</h1>

    <p>Mostrando @Model.Items.Count() de @Model.TotalCount</p>

    <!--Se añaden clases a las tablas-->
    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Título</th>
                <th>Categoría</th>
                <th>Completada</th>
                <th>Step</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Items)
            {
                <tr>
                    <td>@t.Id</td>
                    <td>@t.Title</td>
                    <td>@t.CategoryName</td>
                    <td>@(t.IsCompleted ? "Sí" : "No")</td>
                    <td>@t.Step</td>
                </tr>
            }
        </tbody>
    </table>

</div>