@model TaskManager.Web.Models.PagedResultViewModel<TaskManager.Web.Models.TaskViewModel>

@{
    ViewData["Title"] = "Tareas";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">

    <partial name="_AlertMessages" />


    <h1>Tareas
        <a asp-action="Create" class="btn btn-sm btn-primary">Agregar</a>
    </h1>

    <p>Mostrando @Model.Items.Count() de @Model.TotalCount</p>

    <!--Se añaden clases a las tablas-->
    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Título</th>
                <th>Categoría</th>
                <th>Completada</th>
                <th>Step</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Items) // foreach para recorrer lo proveniente de la api
            {
                <tr>
                    <td>@t.Id</td>
                    <td>@t.Title</td>
                    <td>@t.CategoryName</td>
                    <td>@(t.IsCompleted ? "Sí" : "No")</td>
                    <td>@t.Step</td>
                    <td> 

                        <!--Tag Helpers: Para no escribir las url a mano y que el MVC componga correctamente los enlaces según adónde se quiera apuntar-->
                        <a asp-controller="Tasks" asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-primary">
                            Ver detalles </a> <!-- 30ene: Etiqueta <a> dado el método GET -->
                        <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-primary">Editar</a> <!--28ene: Botón Editar-->
                        <form asp-action="Delete" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@t.Id" />
                            <button type="submit" class="btn btn-danger btn-sm"
                                    onclick="return confirm('¿Estás seguro de que deseas eliminar esta tarea?');">Eliminar
                            </button> 
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>