@model TaskManager.Web.Models.TaskSearchViewModel

@{
    ViewData["Title"] = "Búsqueda de Tareas";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">
    <partial name="_AlertMessages" />

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Tareas</h1>
        <a asp-action="Create" class="btn btn-primary">+ Agregar Nueva Tarea</a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-bold">Texto</label>
                    <input asp-for="Text" class="form-control form-control-sm" placeholder="Buscar título..." />
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold">Cat. Id</label>
                    <input asp-for="CategoryId" class="form-control form-control-sm" type="number" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold">Nombre Categoría</label>
                    <input asp-for="CategoryName" class="form-control form-control-sm" />
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold">Step</label>
                    <input asp-for="Step" class="form-control form-control-sm" type="number" />
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold">Estado</label>
                    <select asp-for="IsCompleted" class="form-select form-select-sm">
                        <option value="">-- Todos --</option>
                        <option value="true">Completadas</option>
                        <option value="false">Pendientes</option>
                    </select>
                </div>

                <div class="col-md-12 d-flex gap-2">
                    <button type="submit" class="btn btn-dark btn-sm">Buscar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Result != null && Model.Result.Items.Any())
    {
        <p class="text-muted">Mostrando @Model.Result.Items.Count() de @Model.Result.TotalCount tareas.</p>

        <table class="table table-striped table-bordered table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Título</th>
                    <th>Categoría</th>
                    <th>Estado</th>
                    <th>Step</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Result.Items)
                {
                    <tr>
                        <td>@t.Id</td>
                        <td>@t.Title</td>
                        <td><span class="badge bg-info text-dark">@t.CategoryName</span></td>
                        <td>@(t.IsCompleted ? "=D Sí" : " :c No")</td>
                        <td>@t.Step</td>
                        <td>
                            <div class="btn-group">
                                <a asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                                <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                <form asp-action="Delete" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm"
                                            onclick="return confirm('¿Estás seguro de que deseas eliminar esta tarea?');">
                                        Eliminar
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-4">
            @await Html.PartialAsync("_Pagination", Model)
        </div>
    }
    else
    {
        <div class="alert alert-info">No se encontraron resultados para la búsqueda.</div>
    }
</div>



