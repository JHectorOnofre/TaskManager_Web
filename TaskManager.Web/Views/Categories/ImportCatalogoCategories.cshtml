<!--4 para importar Catalogo_categorias-->
@{
    ViewData["Title"] = "Importar Catálogo de Categorías";
}

<h1>Importar Catálogo Masivo</h1>
<p class="text-muted">Archivo Excel (.xlsx) con formato de catálogo.</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form asp-action="ImportCatalogo" method="post" enctype="multipart/form-data" class="mt-4">
    <div class="input-group mb-3">
        <input type="file" name="file" class="form-control" id="inputGroupFile02">
        <label class="input-group-text" for="inputGroupFile02">Elegir archivo</label>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Importar Catálogo</button>
        <a asp-controller="Tasks" asp-action="Index" class="btn btn-secondary">Volver al listado</a>
    </div>
</form>